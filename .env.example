# Neo4j Configuration
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM Configuration (for Graphiti)
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here  # Optional, kept for backwards compatibility

# Backend Server
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# Frontend Development
VITE_PORT=5173

# Logging
LOG_LEVEL=info
LOG_FILE=logs/journalgraph.log

# Feature Flags
ENABLE_AUTO_SYNC=false
ENABLE_SCHEMA_SUGGESTIONS=true

# Paths
DEFAULT_VAULT_PATH=
SCHEMA_CONFIG_PATH=./config/schema.json
